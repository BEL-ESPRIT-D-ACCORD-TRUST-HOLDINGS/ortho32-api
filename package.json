{
  "name": "ortho32-api",
  "version": "1.0.0",
  "description": "ORTHO-32 versioned REST/SSE contract - canonical API gateway for all ORTHO clients",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "openapi:lint": "npx @readme/openapi-parser openapi/ortho-v1.yaml"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.12",
    "tsx": "^4.16.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
